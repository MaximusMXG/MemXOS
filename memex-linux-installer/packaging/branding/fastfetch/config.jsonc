// MemXOS system-wide fastfetch config (/etc/xdg/fastfetch/config.jsonc).
// @MEMXOS_VERSION@ is substituted by packaging/build_deb.py from version.py.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/memxos/memxos-logo.txt",
    // Brand colours can be set here (named colour or e.g. "38;2;R;G;B").
    "color": {"1": "bright_white"}
  },
  "modules": [
    "title",
    "separator",
    {"type": "os", "key": "OS", "format": "MemXOS @MEMXOS_VERSION@ (based on {pretty-name})"},
    "host",
    "kernel",
    "uptime",
    "packages",
    "de",
    "cpu",
    "gpu",
    "memory",
    "disk",
    {"type": "custom", "key": "Support", "format": "memoryexpress.com"}
  ]
}

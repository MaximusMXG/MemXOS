[Unit]
Description=Memory Express first-boot setup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONPATH=/opt/memex-linux-installer
ExecStart=/usr/bin/python3 -m memex_completer.service
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
